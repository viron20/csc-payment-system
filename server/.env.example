# Server
PORT=5000

# MongoDB Atlas / Local
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/csc_payments?retryWrites=true&w=majority

# JWT (Use a strong 64-char secret in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here

# Allowed School Email Domain (comma-separated for multiple, e.g. school.edu, gmail.com)
ALLOWED_EMAIL_DOMAIN=school.edu, gmail.com

# Initial Administrator Credentials (set secure passwords in your private .env)
ADMIN_EMAIL=admin@school.edu
ADMIN_PASSWORD=your_secure_admin_password_here

# Initial Superadmin Credentials (set secure passwords in your private .env)
SUPERADMIN_EMAIL=superadmin@school.edu
SUPERADMIN_PASSWORD=your_secure_superadmin_password_here

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
